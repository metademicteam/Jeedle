# Server-only — never expose to the browser.
# TypeSafe Jev API key. Server route reads process.env.TYPESAFE_API_KEY.
TYPESAFE_API_KEY=your_typesafe_api_key_here

# football-data.org token (X-Auth-Token header). Get yours at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=your_football_data_token_here
